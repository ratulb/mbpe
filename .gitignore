# pixi environments
.pixi/*
!.pixi/config.toml

# editor swap files
*.swp

# scratch / debugging
debug.mojo
outputs/

# benchmark build artifacts
benchmarks/benchmark_rust/target/

# benchmark output files
benchmarks/*_result.txt

# generated corpora (regenerate via benchmarks/generate_corpora.py)
benchmarks/corpus_*KB.txt
benchmarks/corpus_*MB.txt

# benchmark result data
benchmarks/results/

# Python cache
__pycache__/
*.pyc

# generated reference data (regenerate via `pixi run gen-refs`)
benchmarks/ref_splits.json
benchmarks/ref_counts.json

# ad-hoc verification scripts
lb_*.mojo
benchmarks/verify_levelb.*
